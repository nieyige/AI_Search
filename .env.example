# Metaso (秘塔) search API key
METASO_API_KEY=your-metaso-key

# Claude credentials: the SDK reads ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN,
# and ANTHROPIC_BASE_URL if you use a gateway. If these are already exported in
# your shell you do not need to set them here.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

LLM_MODEL=claude-sonnet-5-5
PORT=3000
